#!/usr/bin/env python3
"""stk - a wrapper around macOS Stickies for humans and agents.

Source of truth for tasks is a JSON file (STK_TASKS). Stickies is a view:
this tool reads its files directly (no UI automation) and only rewrites
window geometry while Stickies is quit (tile --apply, with a backup).
"""
import argparse, fcntl, json, os, plistlib, re, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
SDIR = HOME / "Library/Containers/com.apple.Stickies/Data/Library/Stickies"
STATE = SDIR / ".SavedStickiesState"
TASKS = Path(os.environ.get("STK_TASKS", HOME / ".stk/tasks.json"))
BACKUPS = HOME / ".stk/backups"


def sh(*a, check=True):
    return subprocess.run(a, capture_output=True, text=True, check=check).stdout


def text_of(uuid):
    p = SDIR / f"{uuid}.rtfd"
    f = p / "TXT.rtf"
    if not f.exists():
        return ""
    return sh("textutil", "-convert", "txt", "-stdout", str(f), check=False)


def parse_frame(s):
    n = [float(x) for x in re.findall(r"-?\d+(?:\.\d+)?", s)]
    return n if len(n) == 4 else [0, 0, 300, 200]


def stickies():
    state = plistlib.load(open(STATE, "rb")) if STATE.exists() else []
    by = {s["UUID"]: s for s in state}
    links = {t["sticky"]: t["id"] for t in load_tasks() if t.get("sticky")}
    out = []
    for p in SDIR.glob("*.rtfd"):
        u = p.stem
        txt = text_of(u)
        lines = [l for l in txt.splitlines() if l.strip()]
        st = by.get(u, {})
        out.append({
            "uuid": u, "title": lines[0] if lines else "(empty)", "text": txt,
            "mtime": int((p / "TXT.rtf").stat().st_mtime) if (p / "TXT.rtf").exists() else 0,
            "frame": parse_frame(st.get("Frame", "")), "floating": bool(st.get("Floating")),
            "z": st.get("ZOrder", 0), "task": links.get(u),
        })
    return number(out)


def number(notes):
    """Sort notes in reading order (top row first, left to right) and set n = 1, 2, ..."""
    rows = []
    for s in sorted(notes, key=lambda s: -(s["frame"][1] + s["frame"][3])):
        top = s["frame"][1] + s["frame"][3]
        if rows and abs(rows[-1][0] - top) < s["frame"][3] / 2:
            rows[-1][1].append(s)
        else:
            rows.append((top, [s]))
    out = [s for _, r in rows for s in sorted(r, key=lambda s: s["frame"][0])]
    for i, s in enumerate(out, 1):
        s["n"] = i
    return out


def draw(count, cols, cw=4):
    """Print tiles 1..count as a grid of numbers."""
    line = lambda k: print("+" + "+".join("-" * cw for _ in range(k)) + "+")
    for r in range(0, count, cols):
        row = range(r + 1, min(r + cols, count) + 1)
        line(cols if r else len(row))
        print("|" + "|".join(f"{n:^{cw}}" for n in row) + "|")
    if count:
        line(count % cols or cols)


def pick(q):
    allv = stickies()
    if q.isdigit():
        m = [s for s in allv if s["n"] == int(q)]
        if m:
            return m[0]
    m = [s for s in allv if s["uuid"].lower().startswith(q.lower())]
    if not m:
        m = [s for s in allv if q.lower() in s["text"].lower()]
    if len(m) != 1:
        sys.exit(f"{len(m)} stickies match {q!r}; be more specific" if m else f"no sticky matches {q!r}")
    return m[0]


# ---- tasks (source of truth) -------------------------------------------------
def load_tasks():
    return json.load(open(TASKS)) if TASKS.exists() else []


class locked:
    def __enter__(self):
        TASKS.parent.mkdir(parents=True, exist_ok=True)
        self.f = open(TASKS.with_suffix(".lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return load_tasks()

    def save(self, tasks):
        tmp = TASKS.with_suffix(".tmp")
        json.dump(tasks, open(tmp, "w"), ensure_ascii=False, indent=1)
        os.replace(tmp, TASKS)

    def __exit__(self, *a):
        self.f.close()


def find_task(tasks, tid):
    m = [t for t in tasks if t["id"] == tid or t["id"].startswith(tid)]
    if len(m) != 1:
        sys.exit(f"task {tid!r}: {len(m)} matches")
    return m[0]


def cmd_add(a):
    lk = locked()
    with lk as tasks:
        n = max([int(t["id"][1:]) for t in tasks] + [0]) + 1
        t = {"id": f"T{n}", "title": a.title, "status": "todo", "project": a.project or "",
             "next": a.next or "", "links": a.link or [], "sticky": None, "updated": int(time.time())}
        tasks.append(t)
        lk.save(tasks)
    print(t["id"])


def cmd_set(a):
    lk = locked()
    with lk as tasks:
        t = find_task(tasks, a.id)
        for kv in a.kv:
            k, _, v = kv.partition("=")
            if k not in ("title", "status", "project", "next", "sticky"):
                sys.exit(f"unknown field {k}")
            t[k] = v or None if k == "sticky" else v
        t["updated"] = int(time.time())
        lk.save(tasks)
    print(json.dumps(t, ensure_ascii=False))


def cmd_done(a):
    a.kv = ["status=done"]
    cmd_set(a)


def cmd_link(a):
    s = pick(a.sticky)
    a.kv = [f"sticky={s['uuid']}"]
    cmd_set(a)


def cmd_tasks(a):
    ts = [t for t in load_tasks() if a.all or t["status"] != "done"]
    if a.json:
        return print(json.dumps(ts, ensure_ascii=False, indent=1))
    for t in ts:
        print(f"{t['id']:<5}{t['status']:<8}{t['project']:<14}{t['title']}  -> {t['next']}")


# ---- stickies (read-only view) -----------------------------------------------
def cmd_ls(a):
    v = stickies()
    if a.json:
        return print(json.dumps([{k: x[k] for k in x if k != "text"} for x in v], ensure_ascii=False, indent=1))
    for s in v:
        age = time.strftime("%m-%d %H:%M", time.localtime(s["mtime"]))
        print(f"{s['n']:>2}  {age}  {s['title'][:70]}")


def cmd_show(a):
    s = pick(a.q)
    print(s["text"] if not a.json else json.dumps(s, ensure_ascii=False, indent=1))


def cmd_find(a):
    for s in stickies():
        if a.q.lower() in s["text"].lower():
            print(f"{s['n']:>2}  {s['title'][:70]}")


def cmd_open(a):
    sh("open", "-a", "Stickies")


# ---- tiling (offline: edits geometry while Stickies is quit) -----------------
def screens():
    """Usable area of each screen as [x, y, width, height], with the origin at the bottom left."""
    js = ('ObjC.import("AppKit");JSON.stringify($.NSScreen.screens.js.map(s=>{'
          'const f=s.visibleFrame,g=s.frame;return [f.origin.x,f.origin.y,f.size.width,f.size.height,g.origin.y+g.size.height]}))')
    d = json.loads(sh("osascript", "-l", "JavaScript", "-e", js).strip().splitlines()[-1])
    # visibleFrame leaves out the menu bar only on the main screen. When each screen has its own
    # menu bar, the system pushes notes down from under it, so leave the same space on all screens.
    spans = sh("defaults", "read", "com.apple.spaces", "spans-displays", check=False).strip() == "1"
    bar = 0 if spans else d[0][4] - (d[0][1] + d[0][3])
    return [[x, y, w, min(h, top - bar - y)] for x, y, w, h, top in d]


MIN_W, MIN_H = 120, 60   # below this a note is not readable


def fit(n, W, H, w, h, g, cols=None):
    """Return (cols, w, h) for a grid that keeps n tiles inside W x H. Tiles shrink when they do not fit."""
    best = None
    for c in ([cols] if cols else range(1, n + 1)):
        r = -(-n // c)
        fw, fh = min(w, (W - g * (c + 1)) // c), min(h, (H - g * (r + 1)) // r)
        score = min(fw / w, fh / h)
        if best is None or score >= best[0]:   # on a tie, prefer more columns (fewer rows)
            best = (score, c, int(fw), int(fh))
    return best[1:]


def project(title):
    """Project name of a note: the text before the first ｜, |, or / in the title. Empty notes sort last."""
    head = re.split(r"\s*[｜|/]\s*", title.strip().lstrip("？?!！*-·• "), maxsplit=1)[0]
    return head.strip() if title != "(empty)" and head.strip() else "\uffff"


def cmd_tile(a):
    scr = screens()
    if not 0 <= a.screen < len(scr):
        sys.exit(f"no screen {a.screen}; there are {len(scr)} (0..{len(scr) - 1})")
    x0, y0, W, H = scr[a.screen]
    state = plistlib.load(open(STATE, "rb"))
    order = {s["uuid"]: s for s in stickies()}
    key = {"pos": lambda s: s["n"], "mtime": lambda s: -s["mtime"], "title": lambda s: s["title"], "z": lambda s: s["z"],
           "project": lambda s: (project(s["title"]).casefold(), s["n"])}[a.sort]
    items = sorted((order[s["UUID"]] for s in state if s["UUID"] in order), key=key)
    g = a.gap
    if not items:
        return print("no notes")
    cols, w, h = fit(len(items), W, H - a.top, a.width, a.height, g, a.cols)
    if w < MIN_W or h < MIN_H:
        sys.exit(f"{len(items)} notes do not fit on screen {a.screen} ({W:.0f}x{H:.0f})"
                 + ("; raise --cols" if a.cols else "; use a larger screen or delete notes"))
    if (w, h) != (a.width, a.height):
        print(f"notes are {w}x{h} (not {a.width}x{a.height}) so that all {len(items)} fit on screen {a.screen}")
    plan = {}
    for i, s in enumerate(items):
        c, r = i % cols, i // cols
        x = x0 + g + c * (w + g)
        y = y0 + H - a.top - g - (r + 1) * h - r * g   # Cocoa origin is bottom-left
        plan[s["uuid"]] = f"{{{{{x:.0f}, {y:.0f}}}, {{{w}, {h}}}}}"
        if a.coords:
            print(f"{i + 1:>2} {plan[s['uuid']]}  {s['title'][:40]}")
    if not a.coords:
        draw(len(items), cols)
        if a.sort == "project":
            groups = {}
            for i, s in enumerate(items, 1):
                groups.setdefault(project(s["title"]), []).append(i)
            for name, nums in groups.items():
                span = str(nums[0]) if len(nums) == 1 else f"{nums[0]}-{nums[-1]}"
                print(f"{span:>7}  {'(empty)' if name == chr(0xffff) else name}")
    if not a.apply:
        return print("(dry run; add --apply to quit Stickies, rewrite geometry, relaunch)")
    BACKUPS.mkdir(parents=True, exist_ok=True)
    bk = BACKUPS / f"SavedStickiesState.{int(time.time())}"
    shutil.copy2(STATE, bk)
    subprocess.run(["osascript", "-e", 'tell application "Stickies" to quit'], check=False)
    for _ in range(50):
        if subprocess.run(["pgrep", "-x", "Stickies"], capture_output=True).returncode:
            break
        time.sleep(0.2)
    else:
        sys.exit("Stickies did not quit; nothing changed")
    state = plistlib.load(open(STATE, "rb"))   # re-read: Stickies rewrites it on quit
    for s in state:
        if s["UUID"] in plan:
            s["Frame"] = plan[s["UUID"]]
            s["ExpandedSize"] = f"{{{w}, {h}}}"
    plistlib.dump(state, open(STATE, "wb"), fmt=plistlib.FMT_BINARY)
    # The system can refuse to start an app that has only just quit; try again.
    for _ in range(10):
        time.sleep(0.5)
        if subprocess.run(["open", "-a", "Stickies"], capture_output=True).returncode == 0:
            break
    else:
        sys.exit(f"positions are saved, but Stickies did not start; run: open -a Stickies (backup: {bk})")
    print(f"done; backup: {bk}")


def cmd_create(a):
    from background_note import create
    try:
        result = create(a.store, a.title, a.body, a.url, a.label, a.apply)
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
    print(json.dumps(result, ensure_ascii=False, indent=2))


def main():
    p = argparse.ArgumentParser(prog="stk", description=__doc__)
    sp = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *args, **kw):
        q = sp.add_parser(name, help=kw.get("help"))
        for ar, ak in args:
            q.add_argument(*ar if isinstance(ar, tuple) else (ar,), **ak)
        q.set_defaults(fn=fn)

    add("create", cmd_create, ("title", {}), (("--body",), {"default": ""}),
        (("--url",), {"required": True}), (("--label",), {"default": "返回任务"}),
        (("--store",), {"default": str(SDIR)}), (("--apply",), {"action": "store_true"}),
        help="experimental offline rich-text creation; dry run unless --apply; never restarts Stickies")
    J = (("--json",), {"action": "store_true"})
    add("ls", cmd_ls, J, help="list all stickies")
    add("show", cmd_show, ("q", {}), J, help="print one sticky (uuid prefix or text match)")
    add("find", cmd_find, ("q", {}), help="search sticky text")
    add("open", cmd_open, help="bring Stickies (all notes) to front")
    add("tasks", cmd_tasks, (("--all",), {"action": "store_true"}), J, help="list tasks")
    add("add", cmd_add, ("title", {}), (("--project",), {}), (("--next",), {}), (("--link",), {"action": "append"}), help="add task")
    add("set", cmd_set, ("id", {}), ("kv", {"nargs": "+"}), help="set fields: status=doing next=...")
    add("done", cmd_done, ("id", {}), help="mark done")
    add("link", cmd_link, ("id", {}), ("sticky", {}), help="link task to a sticky")
    add("tile", cmd_tile, (("--screen",), {"type": int, "default": 0}), (("--cols",), {"type": int}),
        (("--width",), {"type": int, "default": 300}), (("--height",), {"type": int, "default": 200}),
        (("--gap",), {"type": int, "default": 8}), (("--top",), {"type": int, "default": 0}), (("--sort",), {"default": "pos", "choices": ["pos", "project", "mtime", "title", "z"]}),
        (("--coords",), {"action": "store_true"}),
        (("--apply",), {"action": "store_true"}), help="grid-arrange stickies on one screen")
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
